    "Parked in spot %lld. It’ll come back %@." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaparkováno na místě %1$lld. Vrátí se %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkeret på plads %1$lld. Den kommer tilbage %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Platz %1$lld geparkt. Sie kommt %2$@ zurück."
