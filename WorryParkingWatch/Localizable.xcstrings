    "Say it once and let it go until Worry Time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte to jednou a pusťte to z hlavy až do času na starosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig det én gang, og giv slip til bekymringstiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal aussprechen und bis zur Sorgenzeit loslassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε το μία φορά και αφήστε το μέχρι την ώρα της ανησυχίας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say it once and let it go until Worry Time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo una vez y suéltalo hasta la hora de preocuparse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano se kerran ja päästä irti huoliaikaan asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-le une fois, puis lâchez prise jusqu’à l’heure des soucis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan sekali, lalu lepaskan sampai Waktu Khawatir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dillo una volta e lascialo andare fino all’ora delle preoccupazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度言って、心配タイムまで手放しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 말하고, 걱정 시간까지 내려놓아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det én gang, og slipp det til bekymringstiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het één keer en laat het los tot de zorgentijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz to raz i odpuść do pory na zmartwienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga uma vez e deixe para lá até a hora de se preocupar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите один раз и отпустите до времени тревог."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg det en gång och släpp det till orotiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดครั้งเดียว แล้ววางไว้จนถึงเวลากังวล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez söyle, Endişe Saatine kadar bırak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói ra một lần rồi gác lại đến giờ lo lắng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说一次，就放下它，等到烦恼时间再说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說一次，就放下它，等到煩惱時間再說。"
