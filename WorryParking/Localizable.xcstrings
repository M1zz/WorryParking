    "Everything you write stays on this device. Notifications never include your worry text." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše, co napíšeš, zůstává v tomto zařízení. Upozornění nikdy neobsahují text tvé starosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du schreibst, bleibt auf diesem Gerät. Hinweise enthalten nie den Text deiner Sorge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you write stays on this device. Notifications never include your worry text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que escribes se queda en este dispositivo. Las notificaciones nunca incluyen el texto de tus preocupaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que tu écris reste sur cet appareil. Les notifications n’incluent jamais le texte de ton souci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che scrivi resta su questo dispositivo. Le notifiche non includono mai il testo della tua preoccupazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書いた内容はすべてこのデバイスだけに保存されます。通知に心配の内容が表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성한 내용은 모두 이 기기에만 저장돼요. 알림에는 걱정 내용이 절대 표시되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você escreve fica neste aparelho. As notificações nunca incluem o texto da sua preocupação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что вы пишете, хранится только на этом устройстве. В уведомлениях никогда не бывает текста ваших тревог."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างที่คุณเขียนจะอยู่บนอุปกรณ์เครื่องนี้เท่านั้น การแจ้งเตือนจะไม่มีข้อความความกังวลของคุณเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ bạn viết chỉ nằm trên thiết bị này. Thông báo không bao giờ chứa nội dung nỗi lo của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你写下的内容都只保存在这台设备上。通知里绝不会出现烦恼的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你寫下的內容都只儲存在這台裝置上。通知裡絕對不會出現煩惱的內容。"
          }
        }
      }
    },
