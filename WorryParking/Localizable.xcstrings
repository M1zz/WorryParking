    "When people with chronic worry tracked their worries, %lld%% of them didn't come true." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když lidé s chronickými starostmi sledovali své starosti, %lld %% z nich se nesplnilo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
