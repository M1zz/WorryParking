    "Swipe along the dotted line to park" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeď po tečkované čáře a zaparkuj"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Parken am gepunkteten Strich entlangwischen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe along the dotted line to park"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza por la línea de puntos para aparcar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse le long de la ligne pointillée pour garer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri lungo la linea tratteggiata per parcheggiare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点線に沿ってなぞって駐車"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점선을 따라 쓱 그어서 주차하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize pela linha pontilhada para estacionar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите по пунктирной линии, чтобы припарковать"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดตามเส้นประเพื่อจอด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt theo đường chấm để đỗ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿着虚线滑动即可停放"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著虛線滑動即可停放"
          }
        }
      }
    },
    "Swipe along the dotted line. Once it tears off, this worry is parked until %@." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeď po tečkované čáře. Jakmile se lístek utrhne, tato starost bude zaparkovaná do %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische am gepunkteten Strich entlang. Sobald das Ticket abgerissen ist, ist diese Sorge bis %@ geparkt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe along the dotted line. Once it tears off, this worry is parked until %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza por la línea de puntos. Cuando se rompa el ticket, esta preocupación quedará aparcada hasta %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse le long de la ligne pointillée. Une fois le ticket déchiré, ce souci est garé jusqu’à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri lungo la linea tratteggiata. Appena il biglietto si stacca, questa preoccupazione resta parcheggiata fino a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点線に沿ってなぞりましょう。切り離すと、この心配は %@ まで駐車されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점선을 따라 쓱 그어 보세요. 티켓이 끊기는 순간, 이 걱정은 %@까지 주차돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize pela linha pontilhada. Quando o ticket se soltar, esta preocupação ficará estacionada até %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите по пунктирной линии. Как только талон оторвётся, тревога будет припаркована до %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดตามเส้นประ เมื่อบัตรฉีกขาด ความกังวลนี้จะจอดอยู่จนถึง %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt theo đường chấm. Khi vé được xé ra, nỗi lo này sẽ được đỗ đến %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿着虚线滑动。票撕下后，这个烦恼就会停放到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著虛線滑動。票撕下後，這個煩惱就會停放到 %@。"
          }
        }
      }
    },
    "Take one slow breath. There's nothing to do about it right now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednou se pomalu nadechni. Teď s tím nemusíš nic dělat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme einmal langsam durch. Im Moment gibt es nichts, was du dagegen tun müsstest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take one slow breath. There's nothing to do about it right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira hondo y despacio una vez. Ahora mismo no hay nada que hacer con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends une inspiration lente. Il n’y a rien à faire à ce sujet pour l’instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai un respiro lento. Per ora non c’è niente da fare al riguardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり深呼吸をひとつ。今はこの心配について、することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천천히 숨을 한 번 쉬어 보세요. 지금은 이 걱정에 대해 할 일이 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respire fundo uma vez, devagar. Por enquanto, não há nada a fazer sobre isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте один медленный вдох. Прямо сейчас с этим ничего не поделать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หายใจเข้าออกช้า ๆ หนึ่งครั้ง ตอนนี้ยังไม่มีอะไรต้องทำกับมัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy hít một hơi thật chậm. Lúc này bạn chưa cần làm gì với nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢深呼吸一次。此刻对这个烦恼无事可做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢深呼吸一次。此刻對這個煩惱無事可做。"
          }
        }
      }
    },
