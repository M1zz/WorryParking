        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela saiu do estacionamento. Deixe-a ir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она уехала с парковки. Пусть едет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มันออกจากที่จอดแล้ว ปล่อยให้มันไปเถอะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó đã rời khỏi bãi đỗ. Hãy để nó đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已驶出停车场。让它走吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已駛出停車場。讓它走吧。"
          }
        }
      }
    },
    "It's parked until tomorrow's Worry Time. When it pops up again in the shower, just tell yourself: it already has a spot." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zaparkovaná do zítřejšího Času na starosti. Až se ve sprše znovu vynoří, prostě si řekni: už má své místo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist bis zur Sorgenzeit morgen geparkt. Wenn sie unter der Dusche wieder auftaucht, sag dir einfach: Sie hat schon einen Platz."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's parked until tomorrow's Worry Time. When it pops up again in the shower, just tell yourself: it already has a spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está aparcada hasta la Hora de preocuparse de mañana. Cuando vuelva a aparecer en la ducha, dite: ya tiene plaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est garé jusqu’à l’heure des soucis de demain. Quand il resurgit sous la douche, dis-toi simplement : il a déjà une place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È parcheggiata fino all’Ora delle preoccupazioni di domani. Se riaffiora sotto la doccia, ripeti a te stesso: ha già un posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日の心配タイムまで駐車中です。お風呂でまた浮かんできたら、「もう場所はあるよ」と伝えるだけで大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 걱정 시간까지 주차해 뒀어요. 샤워하다 다시 떠오르면 '이미 자리가 있어'라고만 말해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela está estacionada até a Hora de se preocupar de amanhã. Quando ela aparecer de novo no banho, diga a si mesmo: ela já tem uma vaga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она припаркована до завтрашнего времени тревог. Если в душе она всплывёт снова, просто скажите себе: для неё уже есть место."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มันจอดอยู่จนถึงเวลากังวลของพรุ่งนี้ ถ้ามันโผล่มาอีกตอนอาบน้ำ ก็บอกตัวเองว่า มันมีที่จอดแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó được đỗ đến Giờ lo lắng ngày mai. Khi nó lại hiện ra lúc bạn đang tắm, cứ tự nhủ: nó đã có chỗ đỗ rồi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会一直停到明天的烦恼时间。洗澡时它再冒出来，就对自己说：它已经有车位了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它會一直停到明天的煩惱時間。洗澡時它再冒出來，就對自己說：它已經有車位了。"
          }
        }
      }
    },
    "It's Worry Time. Give it %lld focused minutes, then decide what to do with it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Čas na starosti. Věnuj jí %lld minut soustředěné pozornosti a pak se rozhodni, co s ní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist Sorgenzeit. Schenk ihr %lld Minuten volle Aufmerksamkeit und entscheide dann, was du damit machst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's Worry Time. Give it %lld focused minutes, then decide what to do with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la Hora de preocuparse. Dedícale %lld minutos de atención y luego decide qué hacer con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est l’heure des soucis. Accorde-lui %lld minutes d’attention, puis décide quoi en faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È l’Ora delle preoccupazioni. Dedicale %lld minuti di attenzione, poi decidi cosa farne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心配タイムです。%lld 分だけ集中して向き合い、どうするか決めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걱정 시간이에요. %lld분만 집중해서 들여다보고 어떻게 할지 정해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É a Hora de se preocupar. Dê %lld minutos de atenção a ela e depois decida o que fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время тревог. Уделите ей %lld мин внимания, а потом решите, что с ней делать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถึงเวลากังวลแล้ว ให้เวลากับมัน %lld นาทีอย่างตั้งใจ แล้วตัดสินใจว่าจะทำอย่างไรต่อ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đến Giờ lo lắng rồi. Hãy dành %lld phút tập trung cho nó, rồi quyết định sẽ làm gì với nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烦恼时间到了。给它 %lld 分钟专注的时间，然后决定怎么处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煩惱時間到了。給它 %lld 分鐘專注的時間，然後決定怎麼處理。"
          }
        }
      }
    },
