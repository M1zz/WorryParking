    "Bring a worry back exactly when you can handle it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzvedni starost přesně ve chvíli, kdy ji zvládneš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol eine Sorge genau dann zurück, wenn du dich ihr stellen kannst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring a worry back exactly when you can handle it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera una preocupación justo cuando puedas con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressors un souci exactement quand tu es prêt à l’affronter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi una preoccupazione esattamente quando sei in grado di affrontarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向き合えるときに、ちょうどその時間に心配を取り出しましょう。"
