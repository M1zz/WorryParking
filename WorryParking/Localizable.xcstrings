    },
    "Swipe along the dotted line. Once it tears off, this worry is parked until %@." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe along the dotted line. Once it tears off, this worry is parked until %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点線に沿ってなぞりましょう。切り離すと、この心配は %@ まで駐車されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점선을 따라 쓱 그어 보세요. 티켓이 끊기는 순간, 이 걱정은 %@까지 주차돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿着虚线滑动。票撕下后，这个烦恼就会停放到 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著虛線滑動。票撕下後，這個煩惱就會停放到 %@。"
          }
        }
      }
    },
    "Take one slow breath. There's nothing to do about it right now." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take one slow breath. There's nothing to do about it right now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり深呼吸をひとつ。今はこの心配について、することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천천히 숨을 한 번 쉬어 보세요. 지금은 이 걱정에 대해 할 일이 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢深呼吸一次。此刻对这个烦恼无事可做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢深呼吸一次。此刻對這個煩惱無事可做。"
          }
        }
      }
    },
