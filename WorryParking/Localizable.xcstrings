    "Bring a worry back exactly when you can handle it." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring a worry back exactly when you can handle it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向き合えるときに、ちょうどその時間に心配を取り出しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
