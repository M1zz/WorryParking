    "What if I blank during tomorrow's presentation and everyone decides I'm not good enough?" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if I blank during tomorrow's presentation and everyone decides I'm not good enough?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 발표 때 머리가 하얘져서 다들 내가 무능하다고 생각하면 어떡하지?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
