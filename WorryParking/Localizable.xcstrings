    "Drive out" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출차하기"
          }
        }
      }
    },
    "Empty" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈자리"
          }
        }
      }
    },
    "Everything you write stays on this device. Notifications never include your worry text." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성한 내용은 모두 이 기기에만 저장돼요. 알림에는 걱정 내용이 절대 표시되지 않아요."
          }
        }
      }
    },
    "EXIT" : {
      "localizations" : {
