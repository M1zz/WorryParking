    "Write down one worry that's on your mind right now. It will really be parked and come back %@." : {
      "comment" : "A description of the onboarding step where the user writes down a worry.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down one worry that's on your mind right now. It will really be parked and come back %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 머릿속에 있는 걱정 하나를 적어 보세요. 실제로 주차되고, %@에 다시 돌아와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写下此刻脑子里的一个烦恼。它会真的被停放，并在%@回来。"
