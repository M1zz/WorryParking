    "How loud is it right now?" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How loud is it right now?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
