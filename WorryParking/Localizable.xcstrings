    "We'll tell you when a worry is ready for pickup." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll tell you when a worry is ready for pickup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心配が出庫できるときにお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
