    "Making a concrete plan stopped unfinished tasks from intruding on people's thoughts, and five minutes of writing before bed helped people fall asleep faster." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrétní plán zabránil nedokončeným úkolům, aby se vtíraly do myšlenek, a pět minut psaní před spaním pomohlo lidem rychleji usnout."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein konkreter Plan hielt unerledigte Aufgaben aus den Gedanken heraus, und fünf Minuten Schreiben vor dem Schlafen halfen Menschen, schneller einzuschlafen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Making a concrete plan stopped unfinished tasks from intruding on people's thoughts, and five minutes of writing before bed helped people fall asleep faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer un plan concreto evitó que las tareas pendientes invadieran los pensamientos, y escribir cinco minutos antes de dormir ayudó a la gente a conciliar el sueño más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire un plan concret a empêché les tâches inachevées d’envahir les pensées, et cinq minutes d’écriture avant de dormir ont aidé les gens à s’endormir plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare un piano concreto ha impedito ai compiti in sospeso di invadere i pensieri, e cinque minuti di scrittura prima di dormire hanno aiutato le persone ad addormentarsi più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "具体的な計画を立てると、やり残したことが頭に入り込みにくくなり、寝る前に 5 分書き出した人は早く眠りにつけました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구체적인 계획을 세우면 끝나지 않은 일이 생각에 덜 끼어들었고, 자기 전 5분 동안 할 일을 적은 사람들은 더 빨리 잠들었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazer um plano concreto impediu que tarefas inacabadas invadissem os pensamentos, e cinco minutos de escrita antes de dormir ajudaram as pessoas a pegar no sono mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретный план не давал незавершённым делам лезть в мысли, а пять минут записей перед сном помогали быстрее засыпать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การวางแผนที่เป็นรูปธรรมช่วยไม่ให้งานค้างแทรกเข้ามาในความคิด และการเขียนห้านาทีก่อนนอนช่วยให้หลับเร็วขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lập một kế hoạch cụ thể giúp những việc dang dở không còn xen vào suy nghĩ, và viết năm phút trước khi ngủ giúp mọi người ngủ nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制定具体计划后，没做完的事就不再闯进思绪；睡前写五分钟，还能让人更快入睡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擬定具體計畫後，沒做完的事就不再闖進思緒；睡前寫五分鐘，還能讓人更快入睡。"
          }
        }
      }
    },
