        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감당할 수 있을 때 정확히 그 시간에 꺼내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga uma preocupação de volta exatamente quando você der conta dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращайте тревогу ровно тогда, когда вам по силам с ней справиться."
