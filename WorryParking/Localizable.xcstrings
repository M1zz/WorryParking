    "Swipe along the dotted line. Once it tears off, this worry is parked until %@." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe along the dotted line. Once it tears off, this worry is parked until %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점선을 따라 쓱 그어 보세요. 티켓이 끊기는 순간, 이 걱정은 %@까지 주차돼요."
          }
        },
        "zh-Hans" : {
