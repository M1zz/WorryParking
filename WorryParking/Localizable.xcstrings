    "Parked worries stay hidden until their exit time. You don't have to carry them right now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaparkované starosti zůstávají skryté do času výjezdu. Teď je nemusíš nosit s sebou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geparkte Sorgen bleiben bis zu ihrer Ausfahrtszeit verborgen. Du musst sie jetzt nicht mit dir herumtragen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parked worries stay hidden until their exit time. You don't have to carry them right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preocupaciones aparcadas permanecen ocultas hasta su hora de salida. No tienes que cargar con ellas ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soucis garés restent masqués jusqu’à leur heure de sortie. Tu n’as pas à les porter pour l’instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le preoccupazioni parcheggiate restano nascoste fino al loro orario di uscita. Non devi portartele dietro adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駐車した心配は、出庫時間まで隠れています。今は抱えていなくて大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차된 걱정은 출차 시간까지 숨겨져 있어요. 지금 짊어지고 있지 않아도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As preocupações estacionadas ficam ocultas até o horário de saída. Você não precisa carregá-las agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Припаркованные тревоги скрыты до времени выезда. Нести их сейчас не нужно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความกังวลที่จอดไว้จะถูกซ่อนจนถึงเวลาออก คุณไม่ต้องแบกมันไว้ตอนนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nỗi lo đã đỗ sẽ được ẩn đến giờ ra bãi. Bạn không phải mang chúng theo lúc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停放的烦恼在出场时间之前都会被遮住。你现在不用背着它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停放的煩惱在出場時間之前都會被遮住。你現在不用揹著它們。"
          }
        }
      }
    },
    "Parked. Not your job right now." : {
