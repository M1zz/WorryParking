    "%lld%% of the fears you checked didn't come true." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of the fears you checked didn't come true."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認した心配のうち、%lld%% は実際には起こりませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인한 걱정 중 %lld%%는 실제로 일어나지 않았어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你核对过的担忧里，有 %lld%% 并没有成真。"
