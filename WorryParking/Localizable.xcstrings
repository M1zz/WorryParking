    "It was %lld when you parked it." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was %lld when you parked it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
