    "Now that it's parked, how loud is it?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď, když je zaparkovaná, jak je hlasitá?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt, wo sie geparkt ist: Wie laut ist sie?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now that it's parked, how loud is it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora que está aparcada, ¿qué volumen tiene?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant qu’il est garé, à quel point est-il fort ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora che è parcheggiata, quanto è forte?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駐車してみて、今はどれくらい強く響きますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차하고 나니, 지금은 얼마나 크게 울리나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora que ela está estacionada, o quanto ela está alta?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь, когда она припаркована, насколько громко она звучит?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้จอดแล้ว มันดังแค่ไหน?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ nó đã được đỗ, nó ồn đến đâu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停好之后，它现在有多响？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停好之後，它現在有多響？"
          }
        }
      }
    },
    "One real worry, from 11:40 PM to Worry Time the next day." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna skutečná starost, od 23:40 do Času na starosti následujícího dne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine echte Sorge, von 23:40 Uhr bis zur Sorgenzeit am nächsten Tag."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One real worry, from 11:40 PM to Worry Time the next day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una preocupación real, desde las 23:40 hasta la Hora de preocuparse del día siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vrai souci, de 23 h 40 jusqu’à l’heure des soucis du lendemain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una preoccupazione vera, dalle 23:40 all’Ora delle preoccupazioni del giorno dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際にある心配ひとつを、夜 11:40 から翌日の心配タイムまで追います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 걱정 하나가 밤 11시 40분부터 다음 날 걱정 시간까지 가는 과정이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma preocupação real, das 23h40 até a Hora de se preocupar do dia seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна настоящая тревога: от 23:40 до времени тревог на следующий день."
          }
        },
        "th" : {
