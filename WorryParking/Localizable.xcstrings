        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы отложили тревогу и намеренно вернулись к ней. В этом весь приём."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเลื่อนความกังวลไว้ แล้วกลับมาเผชิญมันโดยตั้งใจ นี่คือเทคนิคทั้งหมดแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã trì hoãn một nỗi lo và chủ động quay lại với nó. Đó là toàn bộ kỹ thuật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你把烦恼推迟了，又特意回头面对它。这就是这个方法的全部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
