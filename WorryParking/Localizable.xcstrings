    "Postponing works best when you wait. Most worries feel smaller by Worry Time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkládání funguje nejlépe, když počkáš. V Čase na starosti se většina starostí zdá menší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufschieben wirkt am besten, wenn du wartest. Die meisten Sorgen fühlen sich zur Sorgenzeit kleiner an."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
