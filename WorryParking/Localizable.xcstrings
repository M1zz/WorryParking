    "Did what you feared actually happen?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걱정했던 일이 실제로 일어났나요?"
          }
        }
      }
    },
    "Didn't happen" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안 일어남"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
