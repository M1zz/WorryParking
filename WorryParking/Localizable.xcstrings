    "It was %lld when you parked it." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was %lld when you parked it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駐車したときは %lld でした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차할 때는 %lld였어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停放时是 %lld。"
