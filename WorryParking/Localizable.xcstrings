    "After parking it, how do you feel?" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After parking it, how do you feel?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차하고 나니 기분이 어때요?"
